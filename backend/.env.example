SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./finsmart.db

# Opcional: orígenes permitidos por CORS, separados por coma (normalmente no
# hace falta, ya que en producción Next.js hace de proxy server-side).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: notificaciones por correo (invitaciones a grupos, confirmación de
# pago, alertas de presupuesto). Si se dejan vacías, el envío se omite sin
# romper nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM_NAME=FinSmart
APP_PUBLIC_URL=http://localhost:3000

# Opcional: resuelve el reCAPTCHA v2 del portal de pago PSE de Claro
# (services/claro_pse.py). Sin esta clave, ese flujo específico falla con
# un error controlado sin afectar el resto de la plataforma.
TWOCAPTCHA_API_KEY=
