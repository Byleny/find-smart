# Clave que firma los tokens JWT (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si falta o es corta, el backend usa una clave aleatoria por arranque
# (las sesiones se cierran cada vez que se reinicia).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./finsmart.db

# Opcional: cifrado en reposo de la base de datos con SQLCipher. Vacío = SQLite sin cifrar.
DB_ENCRYPTION_KEY=

# Opcional: bloqueo temporal tras inicios de sesión fallidos (por cuenta).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Opcional: tope de integrantes que un usuario puede agregar a sus grupos por hora.
MIEMBROS_MAX_POR_HORA=20

# Opcional: datos del responsable que muestra la política de tratamiento de datos.
# POLITICA_RESPONSABLE=
# POLITICA_DOMICILIO=
# POLITICA_CORREO=
# POLITICA_TELEFONO=

# Opcional: orígenes permitidos por CORS, separados por coma (normalmente no
# hace falta, ya que en producción Next.js hace de proxy server-side).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: notificaciones por correo (invitaciones a grupos, confirmación de
# pago, alertas de presupuesto). Si se dejan vacías, el envío se omite sin
# romper nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM_NAME=FinSmart
APP_PUBLIC_URL=http://localhost:3000

# Opcional: resuelve el reCAPTCHA v2 del portal de pago PSE de Claro
# (services/claro_pse.py). Sin esta clave, ese flujo específico falla con
# un error controlado sin afectar el resto de la plataforma.
TWOCAPTCHA_API_KEY=
