# Variables de entorno para docker-compose.prod.yml
# Copiar a .env en el servidor y completar antes de "docker compose -f docker-compose.prod.yml up -d --build"

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Clave de cifrado de la base de datos (SQLCipher). Se genera igual que SECRET_KEY.
# Si ya existe una base sin cifrar en el volumen, migrarla antes con
# backend/cifrar_base_de_datos.py; de lo contrario el backend no podrá abrirla.
DB_ENCRYPTION_KEY=
